# FarmaSearch - Environment Variables
# Copy this file as ".env" and fill in your values.

# PostgreSQL / Supabase
DB_USER=postgres.your-ref
DB_PASSWORD=your-password
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# Email notifications
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_RECEIVER=your-email@domain.com

# Flask
FLASK_SECRET=change-this-to-a-random-string
